{
  "name": "ttb-label-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:cloudflare": "wrangler dev",
    "build": "tsc -p tsconfig.build.json",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types .wrangler/worker-configuration.d.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check \"{src,test}/**/*.ts\" \"public/**/*.{html,css,js}\" \"docs/**/*.md\" \"*.{json,js,ts}\"",
    "format:write": "prettier --write \"{src,test}/**/*.ts\" \"public/**/*.{html,css,js}\" \"docs/**/*.md\" \"*.{json,js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "multer": "^2.2.0",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
